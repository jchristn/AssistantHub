        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mcp_transport) (rate(mcp_server_tool_calls_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{mcp_transport}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
