        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mcp_transport) (mcp_server_active_requests{service_name=~\"$service\"})",
          "legendFormat": "{{mcp_transport}}",
          "range": true,
