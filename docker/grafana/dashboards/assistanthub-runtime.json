            "uid": "prometheus"
          },
          "expr": "process_runtime_dotnet_gc_heap_size_bytes{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
