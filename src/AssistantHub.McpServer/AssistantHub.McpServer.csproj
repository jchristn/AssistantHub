<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AssistantHub.McpServer</RootNamespace>
    <AssemblyName>AssistantHub.McpServer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>AssistantHub.McpServer</Title>
    <Version>0.16.1</Version>
    <Authors>Joel Christner</Authors>
    <Description>MCP server for AssistantHub.</Description>
    <Copyright>(c)2025 Joel Christner</Copyright>
    <DocumentationFile>AssistantHub.McpServer.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8601;CS0618;CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8601;CS0618;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="clean.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="clean.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssistantHub.Core\AssistantHub.Core.csproj" />
    <ProjectReference Include="..\..\sdk\csharp\AssistantHub.Sdk\AssistantHub.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radiant" Version="0.1.2" />
    <PackageReference Include="SyslogLogging" Version="2.2.2" />
    <PackageReference Include="Voltaic" Version="0.6.1" />
  </ItemGroup>

</Project>
