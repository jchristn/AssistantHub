<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AssistantHub benchmark harness. Black-box: it talks to AssistantHub only over REST (and to model endpoints
    directly for the independent judge), and never references AssistantHub assemblies, so the same commands can
    measure a working tree or any deployment. See benchmarks/README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Version>0.1.0</Version>
    <Authors>Joel Christner</Authors>
    <Product>AssistantHub</Product>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel, for the in-process stub model server used by load tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
